DISCORD_TOKEN=
OPENAI_API_KEY=
# Fine-grained PAT scoped to the configured repos: Contents (read/write), Pull requests (read/write),
# Actions (read) and Checks (read). Read-only deployments can omit the write scopes.
GITHUB_TOKEN=
# Discord user ID(s) allowed to run /agent admin commands (comma-separated)
OWNER_ID=
# Optional commit identity for bot PRs
# GIT_AUTHOR_NAME=repo-agent-bot
# GIT_AUTHOR_EMAIL=repo-agent-bot@users.noreply.github.com
# Optional Linear integration: Settings → Account → Security & access → Personal API keys
# LINEAR_API_KEY=lin_api_...
# LINEAR_TEAM=ENG   # default team key when the request doesn't name one
